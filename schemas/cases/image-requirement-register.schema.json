{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:projectorigin:schema:cases:image-requirement-register:v1.1",
  "title": "Image Requirement Register v1.1",
  "$comment": "Successor format for Image Throughput Simplification. The schema remains backward-compatible with canonical v1.0 registers. Requirement fulfillment state is distinct from Approved Image Asset registration, Human Approval, Publication, and external Rights state. Deferred external Rights activity alone never satisfies Reader Purpose.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "register_format_version",
    "artifact_type",
    "case_id",
    "requirements"
  ],
  "properties": {
    "register_format_version": {
      "enum": [
        "v1.0",
        "v1.1"
      ]
    },
    "artifact_type": {
      "const": "IMAGE_REQUIREMENT_REGISTER"
    },
    "case_id": {
      "type": "string",
      "pattern": "^FILE-(?!0000)[0-9]{4}$(?![\\s\\S])"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "case_id",
          "requirement_status",
          "reader_purpose",
          "classification_candidate",
          "production_route",
          "dependency_references",
          "source_rights_references",
          "intended_placement_references",
          "current_orchestration_state",
          "blocking_reasons",
          "resulting_asset_reference",
          "completion_condition"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^IMGREQ-(?!000)[0-9]{3}$(?![\\s\\S])"
          },
          "case_id": {
            "type": "string",
            "pattern": "^FILE-(?!0000)[0-9]{4}$(?![\\s\\S])"
          },
          "requirement_status": {
            "enum": [
              "REQUIRED",
              "OPTIONAL"
            ]
          },
          "reader_purpose": {
            "type": "string",
            "minLength": 1
          },
          "classification_candidate": {
            "enum": [
              "Historical Photo",
              "Document Scan",
              "Map",
              "Diagram",
              "AI Visualization",
              "Reconstruction",
              "Background Image",
              "Case Card Image",
              null
            ]
          },
          "production_route": {
            "type": "string",
            "minLength": 1
          },
          "dependency_references": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_rights_references": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "intended_placement_references": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "current_orchestration_state": {
            "type": "string",
            "minLength": 1
          },
          "blocking_reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "fulfillment_mode": {
            "enum": [
              "IMAGE_ASSET",
              "FALLBACK_REPRESENTATION"
            ]
          },
          "fulfillment_status": {
            "enum": [
              "PENDING",
              "SATISFIED"
            ]
          },
          "resulting_asset_reference": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "asset_id",
              "asset_version",
              "repository_path",
              "sha256"
            ],
            "properties": {
              "asset_id": {
                "type": "string",
                "pattern": "^FILE-(?!0000)[0-9]{4}-IMG-[0-9]{4}$(?![\\s\\S])"
              },
              "asset_version": {
                "type": "string",
                "minLength": 1
              },
              "repository_path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
              }
            }
          },
          "resulting_representation_reference": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "representation_type",
              "representation_state",
              "representation_reference",
              "validation_reference",
              "source_references",
              "institutional_locator",
              "evidence_boundary"
            ],
            "properties": {
              "representation_type": {
                "type": "string",
                "minLength": 1
              },
              "representation_state": {
                "const": "VALIDATED_FALLBACK_REPRESENTATION"
              },
              "representation_reference": {
                "type": "string",
                "minLength": 1
              },
              "validation_reference": {
                "type": "string",
                "minLength": 1
              },
              "source_references": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "institutional_locator": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "evidence_boundary": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "external_asset_disposition": {
            "enum": [
              "NOT_APPLICABLE",
              "ACTIVE",
              "DEFERRED"
            ]
          },
          "completion_condition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "register_format_version": {
            "const": "v1.0"
          }
        },
        "required": [
          "register_format_version"
        ]
      },
      "then": {
        "properties": {
          "requirements": {
            "items": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "fulfillment_mode"
                    ]
                  },
                  {
                    "required": [
                      "fulfillment_status"
                    ]
                  },
                  {
                    "required": [
                      "resulting_representation_reference"
                    ]
                  },
                  {
                    "required": [
                      "external_asset_disposition"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "register_format_version": {
            "const": "v1.1"
          }
        },
        "required": [
          "register_format_version"
        ]
      },
      "then": {
        "properties": {
          "requirements": {
            "items": {
              "required": [
                "fulfillment_mode",
                "fulfillment_status",
                "resulting_representation_reference",
                "external_asset_disposition"
              ]
            }
          }
        }
      }
    }
  ]
}
