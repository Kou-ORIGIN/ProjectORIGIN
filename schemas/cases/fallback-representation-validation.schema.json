{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "projectorigin://schemas/cases/fallback-representation-validation/v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "validation_format_version",
    "artifact_type",
    "case_id",
    "requirement_id",
    "representation_type",
    "representation_version",
    "representation_reference",
    "representation_sha256",
    "reader_purpose_reference",
    "reader_purpose_result",
    "validation_basis",
    "source_references",
    "institutional_locator",
    "evidence_boundary",
    "validation_result"
  ],
  "properties": {
    "validation_format_version": {"const": "v1.0"},
    "artifact_type": {"const": "FALLBACK_REPRESENTATION_VALIDATION"},
    "case_id": {"type": "string", "pattern": "^FILE-(?!0000)[0-9]{4}$"},
    "requirement_id": {"type": "string", "pattern": "^IMGREQ-(?!000)[0-9]{3}$"},
    "representation_type": {
      "enum": ["DOCUMENT_SOURCE_CARD", "DOCUMENT_LOCATOR", "TIMELINE", "COMPARISON", "DIAGRAM"]
    },
    "representation_version": {
      "type": "string",
      "pattern": "^v[1-9][0-9]*\\.(0|[1-9][0-9]*)$"
    },
    "representation_reference": {"type": "string", "minLength": 1},
    "representation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reader_purpose_reference": {"type": "string", "minLength": 1},
    "reader_purpose_result": {"const": "SATISFIED"},
    "validation_basis": {"type": "string", "minLength": 1},
    "source_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "institutional_locator": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "evidence_boundary": {"type": "string", "minLength": 1},
    "validation_result": {"const": "VALIDATED_FALLBACK_REPRESENTATION"}
  }
}
