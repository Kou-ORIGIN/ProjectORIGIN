{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:projectorigin:schema:cases:change-impact-assessment:v1.0",
  "title": "Change Impact Assessment v1.0",
  "$comment": "CPW-026 canonical change-impact assessment. Impact categories are evaluated independently. automatic_global_invalidation is always false.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_format_version",
    "artifact_type",
    "case_id",
    "source_step",
    "transaction_id",
    "placement_record_reference",
    "impact_determinations",
    "automatic_global_invalidation",
    "all_applicable_impacts_closed",
    "governing_references",
    "validator_identity",
    "runtime_identity",
    "assessed_at",
    "actor_id",
    "actor_role"
  ],
  "properties": {
    "record_format_version": {
      "const": "v1.0"
    },
    "artifact_type": {
      "const": "CHANGE_IMPACT_ASSESSMENT"
    },
    "case_id": {
      "type": "string",
      "pattern": "^FILE-(?!0000)[0-9]{4}$(?![\\s\\S])"
    },
    "source_step": {
      "const": "CPW-026"
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^FILE-(?!0000)[0-9]{4}-TXN-(?!0000)[0-9]{4}$(?![\\s\\S])"
    },
    "placement_record_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "artifact_id",
        "transaction_id",
        "repository_path",
        "sha256"
      ],
      "properties": {
        "artifact_type": {
          "const": "PLACEMENT_RECORD"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^FILE-(?!0000)[0-9]{4}-TXN-(?!0000)[0-9]{4}$(?![\\s\\S])"
        },
        "transaction_id": {
          "type": "string",
          "pattern": "^FILE-(?!0000)[0-9]{4}-TXN-(?!0000)[0-9]{4}$(?![\\s\\S])"
        },
        "repository_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+/placement-record\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        }
      }
    },
    "impact_determinations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "AUDIT",
        "HUMAN_READ_REVIEW",
        "HUMAN_VISUAL_REVIEW",
        "PLACEMENT",
        "HUMAN_REVIEW_PACKAGE"
      ],
      "properties": {
        "AUDIT": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "determination",
            "closure_state",
            "rationale",
            "evidence_references"
          ],
          "properties": {
            "determination": {
              "enum": [
                "REQUIRED",
                "NOT_REQUIRED",
                "UNDETERMINED"
              ]
            },
            "closure_state": {
              "enum": [
                "OPEN",
                "CLOSED"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidence_references": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "HUMAN_READ_REVIEW": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "determination",
            "closure_state",
            "rationale",
            "evidence_references"
          ],
          "properties": {
            "determination": {
              "enum": [
                "REQUIRED",
                "NOT_REQUIRED",
                "UNDETERMINED"
              ]
            },
            "closure_state": {
              "enum": [
                "OPEN",
                "CLOSED"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidence_references": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "HUMAN_VISUAL_REVIEW": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "determination",
            "closure_state",
            "rationale",
            "evidence_references"
          ],
          "properties": {
            "determination": {
              "enum": [
                "REQUIRED",
                "NOT_REQUIRED",
                "UNDETERMINED"
              ]
            },
            "closure_state": {
              "enum": [
                "OPEN",
                "CLOSED"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidence_references": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "PLACEMENT": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "determination",
            "closure_state",
            "rationale",
            "evidence_references"
          ],
          "properties": {
            "determination": {
              "enum": [
                "REQUIRED",
                "NOT_REQUIRED",
                "UNDETERMINED"
              ]
            },
            "closure_state": {
              "enum": [
                "OPEN",
                "CLOSED"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidence_references": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "HUMAN_REVIEW_PACKAGE": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "determination",
            "closure_state",
            "rationale",
            "evidence_references"
          ],
          "properties": {
            "determination": {
              "enum": [
                "REQUIRED",
                "NOT_REQUIRED",
                "UNDETERMINED"
              ]
            },
            "closure_state": {
              "enum": [
                "OPEN",
                "CLOSED"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidence_references": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "automatic_global_invalidation": {
      "const": false
    },
    "all_applicable_impacts_closed": {
      "type": "boolean"
    },
    "governing_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_path",
          "applicable_version",
          "sha256"
        ],
        "properties": {
          "document_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "applicable_version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
          }
        }
      }
    },
    "validator_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_path",
        "sha256"
      ],
      "properties": {
        "implementation_path": {
          "const": "scripts/validate-placement-transaction.py"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        }
      }
    },
    "runtime_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_version",
        "libraries"
      ],
      "properties": {
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "libraries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "uniqueItems": true
        }
      }
    },
    "assessed_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^(?:ACTOR|HUMAN)-[0-9]{4}$(?![\\s\\S])"
    },
    "actor_role": {
      "type": "string",
      "minLength": 1
    }
  }
}
