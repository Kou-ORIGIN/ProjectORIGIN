{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "projectorigin://schemas/workflows/workflow-adoption-record/v1.0",
  "description": "Stage A mechanism only. Immutable issued records; validation never creates Human authority. Evidence is inline, bound to exact bytes and current controlled artifacts, with no final-record verification hash dependency.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_format_version",
    "adoption_record_id",
    "record_type",
    "target",
    "transition",
    "human_decision",
    "adopted_at",
    "adopted_state_validation_evidence"
  ],
  "properties": {
    "record_format_version": {
      "const": "v1.0"
    },
    "adoption_record_id": {
      "type": "string",
      "pattern": "^WFADOPT-(?!0000)[0-9]{4}$(?![\\s\\S])"
    },
    "record_type": {
      "const": "WORKFLOW_FORMAL_ADOPTION_RECORD"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_path",
        "workflow_version",
        "definition_format_version",
        "candidate_definition_sha256",
        "candidate_git_commit_sha",
        "adopted_definition_sha256"
      ],
      "properties": {
        "workflow_path": {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$(?![\\s\\S])"
        },
        "workflow_version": {
          "type": "string",
          "pattern": "^v[1-9][0-9]*\\.(0|[1-9][0-9]*)$(?![\\s\\S])"
        },
        "definition_format_version": {
          "const": "v1.0"
        },
        "candidate_definition_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "candidate_git_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$(?![\\s\\S])"
        },
        "adopted_definition_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_status",
        "to_status"
      ],
      "properties": {
        "from_status": {
          "const": "PROPOSED"
        },
        "to_status": {
          "const": "ADOPTED"
        }
      }
    },
    "human_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "decision_path",
        "decision_sha256"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "pattern": "^WFADOPTDEC-(?!0000)[0-9]{4}$(?![\\s\\S])"
        },
        "decision_path": {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$(?![\\s\\S])"
        },
        "decision_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        }
      }
    },
    "adopted_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$(?![\\s\\S])"
    },
    "adopted_state_validation_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition_sha256",
        "result",
        "json_integrity",
        "schema_validation",
        "semantic_validation",
        "governance_compatibility",
        "tests",
        "validator_exit_code",
        "controlled_artifact_integrity",
        "controlled_artifacts",
        "warnings"
      ],
      "properties": {
        "definition_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "result": {
          "enum": [
            "PASS",
            "PASS_WITH_WARNINGS"
          ]
        },
        "json_integrity": {
          "const": "PASS"
        },
        "schema_validation": {
          "const": "PASS"
        },
        "semantic_validation": {
          "const": "PASS"
        },
        "governance_compatibility": {
          "const": "PASS"
        },
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "passed",
            "failed",
            "skipped",
            "expected_failures"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 1
            },
            "passed": {
              "type": "integer",
              "minimum": 1
            },
            "failed": {
              "const": 0
            },
            "skipped": {
              "const": 0
            },
            "expected_failures": {
              "const": 0
            }
          }
        },
        "validator_exit_code": {
          "const": 0
        },
        "controlled_artifact_integrity": {
          "const": "PASS"
        },
        "controlled_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$(?![\\s\\S])"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "message",
              "blocking"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "blocking": {
                "const": false
              }
            }
          }
        }
      }
    }
  }
}
