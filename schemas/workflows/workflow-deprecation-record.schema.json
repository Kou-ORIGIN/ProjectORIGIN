{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "projectorigin://schemas/workflows/workflow-deprecation-record/v1.0",
  "description": "Stage A mechanism only. Immutable issued records; validation never creates Human authority. Evidence is inline, bound to exact bytes and current controlled artifacts, with no final-record verification hash dependency.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_format_version",
    "deprecation_record_id",
    "record_type",
    "target",
    "human_authority",
    "deprecated_at",
    "reason",
    "successor"
  ],
  "properties": {
    "record_format_version": {
      "const": "v1.0"
    },
    "deprecation_record_id": {
      "type": "string",
      "pattern": "^WFDEPREC-(?!0000)[0-9]{4}$(?![\\s\\S])"
    },
    "record_type": {
      "const": "WORKFLOW_DEPRECATION_RECORD"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_path",
        "workflow_version",
        "adoption_record_id",
        "adoption_record_path",
        "adoption_record_sha256",
        "adopted_definition_sha256"
      ],
      "properties": {
        "workflow_path": {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$(?![\\s\\S])"
        },
        "workflow_version": {
          "type": "string",
          "pattern": "^v[1-9][0-9]*\\.(0|[1-9][0-9]*)$(?![\\s\\S])"
        },
        "adoption_record_id": {
          "type": "string",
          "pattern": "^WFADOPT-(?!0000)[0-9]{4}$(?![\\s\\S])"
        },
        "adoption_record_path": {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$(?![\\s\\S])"
        },
        "adoption_record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "adopted_definition_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        }
      }
    },
    "human_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_type",
        "authority_path",
        "authority_sha256"
      ],
      "properties": {
        "authority_type": {
          "const": "EXPLICIT_HUMAN_DECISION"
        },
        "authority_path": {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$(?![\\s\\S])"
        },
        "authority_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        }
      }
    },
    "deprecated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$(?![\\s\\S])"
    },
    "reason": {
      "type": "string",
      "pattern": "\\S"
    },
    "successor": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workflow_path",
            "workflow_version",
            "adoption_record_id",
            "adoption_record_path",
            "adoption_record_sha256",
            "adopted_definition_sha256"
          ],
          "properties": {
            "workflow_path": {
              "type": "string",
              "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$(?![\\s\\S])"
            },
            "workflow_version": {
              "type": "string",
              "pattern": "^v[1-9][0-9]*\\.(0|[1-9][0-9]*)$(?![\\s\\S])"
            },
            "adoption_record_id": {
              "type": "string",
              "pattern": "^WFADOPT-(?!0000)[0-9]{4}$(?![\\s\\S])"
            },
            "adoption_record_path": {
              "type": "string",
              "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$(?![\\s\\S])"
            },
            "adoption_record_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "adopted_definition_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
